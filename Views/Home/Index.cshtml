@{
    ViewData["Title"] = "Bem-vindo";
}

<div class="d-flex align-items-center justify-content-center vh-100 bg-gradient">
    <div class="card shadow-lg text-center" style="width: 600px;">
        <div class="card-header bg-primary text-white">
            <h3>Bem-vindo ao WebFamily</h3>
        </div>
        <div class="card-body">
            <p class="lead mb-4">
                Gerencie sua família digital de forma simples e segura.
            </p>
            <div class="d-flex justify-content-around">
                <a asp-controller="Login" asp-action="Index" class="btn btn-primary btn-lg w-40">Login</a>
                <a asp-controller="Login" asp-action="Cadastro" class="btn btn-success btn-lg w-40">Cadastro</a>
            </div>
        </div>
        <div class="card-footer text-muted">
            &copy; 2025 - WebFamily
        </div>
    </div>
</div>
